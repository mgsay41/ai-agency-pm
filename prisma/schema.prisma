generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id           String    @id
  userId       String
  accountId    String
  providerId   String
  accessToken  String?
  refreshToken String?
  idToken      String?
  expiresAt    DateTime?
  password     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  User         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model ActionItem {
  id          String           @id
  meetingId   String
  description String
  assignedTo  String?
  dueDate     DateTime?
  status      ActionItemStatus @default(OPEN)
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime
  TeamMember  TeamMember?      @relation(fields: [assignedTo], references: [id])
  Meeting     Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([status])
}

model ActivityLog {
  id         String   @id
  userId     String
  entityType String
  entityId   String
  action     String
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId])
}

model Client {
  id                     String          @id
  clientType             ClientType
  companyName            String
  industry               String?
  companySize            String?
  website                String?
  billingAddress         String?
  timeZone               String?
  preferredCommunication Json?
  tags                   Json?
  notes                  String?
  isActive               Boolean         @default(true)
  clientSince            DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime
  createdBy              String?
  User                   User?           @relation(fields: [createdBy], references: [id])
  ClientContact          ClientContact[]
  Project                Project[]

  @@index([companyName])
  @@index([isActive])
}

model ClientContact {
  id          String   @id
  clientId    String
  isPrimary   Boolean  @default(false)
  contactName String
  jobTitle    String?
  email       String
  phone       String?
  mobile      String?
  linkedinUrl String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  Client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([email])
}

model Document {
  id          String   @id
  projectId   String
  fileName    String
  filePath    String
  fileType    String?
  fileSize    BigInt?
  category    String?
  description String?
  version     String?
  uploadedBy  String
  uploadedAt  DateTime @default(now())
  isDeleted   Boolean  @default(false)
  Project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  User        User     @relation(fields: [uploadedBy], references: [id])

  @@index([projectId])
}

model Meeting {
  id               String            @id
  projectId        String
  meetingDate      DateTime
  durationMinutes  Int?
  meetingType      MeetingType
  locationPlatform String?
  agenda           String?
  notes            String?
  transcript       String?
  recordingUrl     String?
  nextMeetingDate  DateTime?
  nextMeetingNotes String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime
  createdBy        String?
  ActionItem       ActionItem[]
  User             User?             @relation(fields: [createdBy], references: [id])
  Project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  MeetingAttendee  MeetingAttendee[]

  @@index([meetingDate])
  @@index([projectId])
}

model MeetingAttendee {
  id            String       @id
  meetingId     String
  memberId      String?
  externalName  String?
  externalEmail String?
  attendeeType  AttendeeType
  attended      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  Meeting       Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  TeamMember    TeamMember?  @relation(fields: [memberId], references: [id])

  @@index([meetingId])
}

model Milestone {
  id          String          @id
  projectId   String
  name        String
  description String?
  targetDate  DateTime
  actualDate  DateTime?
  status      MilestoneStatus @default(PENDING)
  orderIndex  Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime
  Project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  Task        Task[]

  @@index([projectId])
}

model Project {
  id                                String              @id
  projectName                       String
  projectCode                       String?             @unique
  clientId                          String
  projectType                       ProjectType
  description                       String?
  internalNotes                     String?
  status                            ProjectStatus       @default(PLANNING)
  priority                          Priority            @default(MEDIUM)
  startDate                         DateTime
  endDate                           DateTime
  actualStartDate                   DateTime?
  actualEndDate                     DateTime?
  estimatedHours                    Decimal?            @db.Decimal(10, 2)
  budgetAmount                      Decimal?            @db.Decimal(12, 2)
  currency                          String              @default("USD")
  billingType                       BillingType?
  progressPercentage                Int                 @default(0)
  currentPhase                      String?
  healthStatus                      HealthStatus?
  isArchived                        Boolean             @default(false)
  archivedAt                        DateTime?
  createdAt                         DateTime            @default(now())
  updatedAt                         DateTime
  createdBy                         String
  lastModifiedBy                    String?
  Document                          Document[]
  Meeting                           Meeting[]
  Milestone                         Milestone[]
  Client                            Client              @relation(fields: [clientId], references: [id])
  User_Project_createdByToUser      User                @relation("Project_createdByToUser", fields: [createdBy], references: [id])
  User_Project_lastModifiedByToUser User?               @relation("Project_lastModifiedByToUser", fields: [lastModifiedBy], references: [id])
  ProjectAssignment                 ProjectAssignment[]
  ProjectExpense                    ProjectExpense[]
  Task                              Task[]
  TimeEntry                         TimeEntry[]

  @@index([clientId])
  @@index([createdBy])
  @@index([endDate])
  @@index([priority])
  @@index([startDate])
  @@index([status])
}

model ProjectAssignment {
  id                   String     @id
  projectId            String
  memberId             String
  roleInProject        String
  allocationPercentage Int        @default(100)
  startDate            DateTime?
  endDate              DateTime?
  isActive             Boolean    @default(true)
  notes                String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime
  TeamMember           TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  Project              Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId, roleInProject])
  @@index([memberId])
  @@index([projectId])
}

model ProjectExpense {
  id          String        @id
  projectId   String
  category    String?
  description String
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("USD")
  expenseDate DateTime
  receiptUrl  String?
  isBillable  Boolean       @default(true)
  submittedBy String
  approvedBy  String?
  status      ExpenseStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  User        User?         @relation(fields: [approvedBy], references: [id])
  Project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  TeamMember  TeamMember    @relation(fields: [submittedBy], references: [id])

  @@index([projectId])
  @@index([status])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime
  token     String   @unique
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model SystemSetting {
  id           String   @id
  settingKey   String   @unique
  settingValue String?
  settingType  String?
  description  String?
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model Task {
  id             String      @id
  projectId      String
  milestoneId    String?
  assignedTo     String?
  title          String
  description    String?
  status         TaskStatus  @default(BACKLOG)
  priority       Priority    @default(MEDIUM)
  estimatedHours Decimal?    @db.Decimal(10, 2)
  actualHours    Decimal?    @db.Decimal(10, 2)
  dueDate        DateTime?
  completedAt    DateTime?
  parentTaskId   String?
  orderIndex     Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime
  createdBy      String?
  TeamMember     TeamMember? @relation(fields: [assignedTo], references: [id])
  User           User?       @relation(fields: [createdBy], references: [id])
  Milestone      Milestone?  @relation(fields: [milestoneId], references: [id])
  Task           Task?       @relation("TaskToTask", fields: [parentTaskId], references: [id])
  other_Task     Task[]      @relation("TaskToTask")
  Project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  TimeEntry      TimeEntry[]

  @@index([assignedTo])
  @@index([projectId])
  @@index([status])
}

model TeamMember {
  id                              String              @id
  userId                          String?             @unique
  fullName                        String
  email                           String              @unique
  phone                           String?
  roleTitle                       String
  department                      Department?
  specialization                  Json?
  skills                          Json?
  hourlyRate                      Decimal?            @db.Decimal(10, 2)
  currency                        String              @default("USD")
  employmentType                  EmploymentType?
  startDate                       DateTime?
  status                          MemberStatus        @default(ACTIVE)
  avatarColor                     String?
  bio                             String?
  linkedinUrl                     String?
  githubUrl                       String?
  createdAt                       DateTime            @default(now())
  updatedAt                       DateTime
  createdBy                       String?
  ActionItem                      ActionItem[]
  MeetingAttendee                 MeetingAttendee[]
  ProjectAssignment               ProjectAssignment[]
  ProjectExpense                  ProjectExpense[]
  Task                            Task[]
  User_TeamMember_createdByToUser User?               @relation("TeamMember_createdByToUser", fields: [createdBy], references: [id])
  User_TeamMember_userIdToUser    User?               @relation("TeamMember_userIdToUser", fields: [userId], references: [id])
  TimeEntry                       TimeEntry[]

  @@index([department])
  @@index([email])
  @@index([status])
}

model TimeEntry {
  id          String     @id
  projectId   String
  taskId      String?
  memberId    String
  workDate    DateTime
  hours       Decimal    @db.Decimal(10, 2)
  description String?
  isBillable  Boolean    @default(true)
  hourlyRate  Decimal?   @db.Decimal(10, 2)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  TeamMember  TeamMember @relation(fields: [memberId], references: [id])
  Project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  Task        Task?      @relation(fields: [taskId], references: [id])

  @@index([memberId])
  @@index([projectId])
  @@index([workDate])
}

model User {
  id                                    String           @id
  email                                 String           @unique
  role                                  Role             @default(TEAM_MEMBER)
  phone                                 String?
  isActive                              Boolean          @default(true)
  lastLogin                             DateTime?
  createdAt                             DateTime         @default(now())
  updatedAt                             DateTime
  createdBy                             String?
  emailVerified                         Boolean          @default(false)
  name                                  String
  Account                               Account[]
  ActivityLog                           ActivityLog[]
  Client                                Client[]
  Document                              Document[]
  Meeting                               Meeting[]
  Project_Project_createdByToUser       Project[]        @relation("Project_createdByToUser")
  Project_Project_lastModifiedByToUser  Project[]        @relation("Project_lastModifiedByToUser")
  ProjectExpense                        ProjectExpense[]
  Session                               Session[]
  Task                                  Task[]
  TeamMember_TeamMember_createdByToUser TeamMember[]     @relation("TeamMember_createdByToUser")
  TeamMember_TeamMember_userIdToUser    TeamMember?      @relation("TeamMember_userIdToUser")
  User                                  User?            @relation("UserToUser", fields: [createdBy], references: [id])
  other_User                            User[]           @relation("UserToUser")

  @@index([email])
  @@index([role])
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttendeeType {
  INTERNAL
  EXTERNAL
}

enum BillingType {
  FIXED_PRICE
  TIME_MATERIALS
  RETAINER
  PRO_BONO
}

enum ClientType {
  COMPANY
  INDIVIDUAL
  NONPROFIT
  GOVERNMENT
}

enum Department {
  DEVELOPMENT
  DESIGN
  QA
  DEVOPS
  MANAGEMENT
  CONSULTING
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  INTERN
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum HealthStatus {
  ON_TRACK
  AT_RISK
  OFF_TRACK
}

enum MeetingType {
  KICKOFF
  DISCOVERY
  PLANNING
  REVIEW
  DEMO
  RETROSPECTIVE
  CLIENT_CALL
  INTERNAL_SYNC
  OTHER
}

enum MemberStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectType {
  AI_AGENT
  AUTOMATION
  SAAS
  CONSULTING
  OTHER
}

enum Role {
  ADMIN
  TEAM_MEMBER
  CLIENT
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}
