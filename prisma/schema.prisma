// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  ADMIN
  TEAM_MEMBER
  CLIENT
}

enum Department {
  DEVELOPMENT
  DESIGN
  QA
  DEVOPS
  MANAGEMENT
  CONSULTING
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  INTERN
}

enum MemberStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum ClientType {
  COMPANY
  INDIVIDUAL
  NONPROFIT
  GOVERNMENT
}

enum ProjectType {
  AI_AGENT
  AUTOMATION
  SAAS
  CONSULTING
  OTHER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum BillingType {
  FIXED_PRICE
  TIME_MATERIALS
  RETAINER
  PRO_BONO
}

enum HealthStatus {
  ON_TRACK
  AT_RISK
  OFF_TRACK
}

enum MeetingType {
  KICKOFF
  DISCOVERY
  PLANNING
  REVIEW
  DEMO
  RETROSPECTIVE
  CLIENT_CALL
  INTERNAL_SYNC
  OTHER
}

enum AttendeeType {
  INTERNAL
  EXTERNAL
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================================
// USER & AUTHENTICATION
// ============================================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(TEAM_MEMBER)
  phone        String?
  isActive     Boolean  @default(true)
  lastLogin    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?

  // Relations
  createdByUser       User?               @relation("UserCreator", fields: [createdBy], references: [id])
  usersCreated        User[]              @relation("UserCreator")
  teamMemberUser      TeamMember?         @relation("TeamMemberUser")
  createdProjects     Project[]           @relation("ProjectCreator")
  modifiedProjects    Project[]           @relation("ProjectModifier")
  createdClients      Client[]
  createdTeamMembers  TeamMember[]        @relation("TeamMemberCreator")
  createdMeetings     Meeting[]
  activityLogs        ActivityLog[]
  createdTasks        Task[]
  uploadedDocuments   Document[]
  approvedExpenses    ProjectExpense[]    @relation("ExpenseApprover")

  @@index([email])
  @@index([role])
}

// ============================================================================
// TEAM MEMBERS
// ============================================================================

model TeamMember {
  id             String          @id @default(cuid())
  userId         String?         @unique
  fullName       String
  email          String          @unique
  phone          String?
  roleTitle      String
  department     Department?
  specialization Json?          // Array of specializations
  skills         Json?          // Array of skills
  hourlyRate     Decimal?       @db.Decimal(10, 2)
  currency       String         @default("USD")
  employmentType EmploymentType?
  startDate      DateTime?
  status         MemberStatus   @default(ACTIVE)
  avatarColor    String?        // Hex color code
  bio            String?        @db.Text
  linkedinUrl    String?
  githubUrl      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdBy      String?

  // Relations
  user              User?                @relation("TeamMemberUser", fields: [userId], references: [id])
  creator           User?                @relation("TeamMemberCreator", fields: [createdBy], references: [id])
  projectAssignments ProjectAssignment[]
  meetingAttendees   MeetingAttendee[]
  actionItems        ActionItem[]
  tasks              Task[]
  timeEntries        TimeEntry[]
  submittedExpenses  ProjectExpense[]    @relation("ExpenseSubmitter")

  @@index([email])
  @@index([status])
  @@index([department])
}

// ============================================================================
// CLIENTS
// ============================================================================

model Client {
  id                     String    @id @default(cuid())
  clientType             ClientType
  companyName            String
  industry               String?
  companySize            String?
  website                String?
  billingAddress         String?   @db.Text
  timeZone               String?
  preferredCommunication Json?     // Array of communication methods
  tags                   Json?     // Array of tags
  notes                  String?   @db.Text
  isActive               Boolean   @default(true)
  clientSince            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  createdBy              String?

  // Relations
  creator  User?           @relation(fields: [createdBy], references: [id])
  contacts ClientContact[]
  projects Project[]

  @@index([companyName])
  @@index([isActive])
}

model ClientContact {
  id          String   @id @default(cuid())
  clientId    String
  isPrimary   Boolean  @default(false)
  contactName String
  jobTitle    String?
  email       String
  phone       String?
  mobile      String?
  linkedinUrl String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([email])
}

// ============================================================================
// PROJECTS
// ============================================================================

model Project {
  id               String         @id @default(cuid())
  projectName      String
  projectCode      String?        @unique
  clientId         String
  projectType      ProjectType
  description      String?        @db.Text
  internalNotes    String?        @db.Text
  status           ProjectStatus  @default(PLANNING)
  priority         Priority       @default(MEDIUM)
  startDate        DateTime
  endDate          DateTime
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  estimatedHours   Decimal?       @db.Decimal(10, 2)
  budgetAmount     Decimal?       @db.Decimal(12, 2)
  currency         String         @default("USD")
  billingType      BillingType?
  progressPercentage Int          @default(0)
  currentPhase     String?
  healthStatus     HealthStatus?
  isArchived       Boolean        @default(false)
  archivedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  createdBy        String
  lastModifiedBy   String?

  // Relations
  client        Client               @relation(fields: [clientId], references: [id])
  creator       User                 @relation("ProjectCreator", fields: [createdBy], references: [id])
  modifier      User?                @relation("ProjectModifier", fields: [lastModifiedBy], references: [id])
  assignments   ProjectAssignment[]
  meetings      Meeting[]
  milestones    Milestone[]
  tasks         Task[]
  documents     Document[]
  timeEntries   TimeEntry[]
  expenses      ProjectExpense[]

  @@index([clientId])
  @@index([status])
  @@index([priority])
  @@index([startDate])
  @@index([endDate])
  @@index([createdBy])
}

model ProjectAssignment {
  id                   String    @id @default(cuid())
  projectId            String
  memberId             String
  roleInProject        String
  allocationPercentage Int       @default(100)
  startDate            DateTime?
  endDate              DateTime?
  isActive             Boolean   @default(true)
  notes                String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  TeamMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId, roleInProject])
  @@index([projectId])
  @@index([memberId])
}

// ============================================================================
// MEETINGS
// ============================================================================

model Meeting {
  id               String       @id @default(cuid())
  projectId        String
  meetingDate      DateTime
  durationMinutes  Int?
  meetingType      MeetingType
  locationPlatform String?
  agenda           String?      @db.Text
  notes            String?      @db.Text
  transcript       String?      @db.Text
  recordingUrl     String?
  nextMeetingDate  DateTime?
  nextMeetingNotes String?      @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  createdBy        String?

  // Relations
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator   User?              @relation(fields: [createdBy], references: [id])
  attendees MeetingAttendee[]
  actionItems ActionItem[]

  @@index([projectId])
  @@index([meetingDate])
}

model MeetingAttendee {
  id            String       @id @default(cuid())
  meetingId     String
  memberId      String?
  externalName  String?
  externalEmail String?
  attendeeType  AttendeeType
  attended      Boolean      @default(true)
  createdAt     DateTime     @default(now())

  // Relations
  meeting Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  member  TeamMember? @relation(fields: [memberId], references: [id])

  @@index([meetingId])
}

model ActionItem {
  id          String           @id @default(cuid())
  meetingId   String
  description String           @db.Text
  assignedTo  String?
  dueDate     DateTime?
  status      ActionItemStatus @default(OPEN)
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  meeting Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  assignee TeamMember? @relation(fields: [assignedTo], references: [id])

  @@index([meetingId])
  @@index([status])
}

// ============================================================================
// MILESTONES & TASKS (Future Use)
// ============================================================================

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  name        String
  description String?         @db.Text
  targetDate  DateTime
  actualDate  DateTime?
  status      MilestoneStatus @default(PENDING)
  orderIndex  Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

model Task {
  id             String     @id @default(cuid())
  projectId      String
  milestoneId    String?
  assignedTo     String?
  title          String
  description    String?    @db.Text
  status         TaskStatus @default(BACKLOG)
  priority       Priority   @default(MEDIUM)
  estimatedHours Decimal?   @db.Decimal(10, 2)
  actualHours    Decimal?   @db.Decimal(10, 2)
  dueDate        DateTime?
  completedAt    DateTime?
  parentTaskId   String?
  orderIndex     Int?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  createdBy      String?

  // Relations
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone   Milestone?   @relation(fields: [milestoneId], references: [id])
  assignee    TeamMember?  @relation(fields: [assignedTo], references: [id])
  creator     User?        @relation(fields: [createdBy], references: [id])
  parentTask  Task?        @relation("TaskSubtasks", fields: [parentTaskId], references: [id])
  subtasks    Task[]       @relation("TaskSubtasks")
  timeEntries TimeEntry[]

  @@index([projectId])
  @@index([status])
  @@index([assignedTo])
}

// ============================================================================
// DOCUMENTS (Future Use)
// ============================================================================

model Document {
  id          String   @id @default(cuid())
  projectId   String
  fileName    String
  filePath    String
  fileType    String?
  fileSize    BigInt?
  category    String?
  description String?  @db.Text
  version     String?
  uploadedBy  String
  uploadedAt  DateTime @default(now())
  isDeleted   Boolean  @default(false)

  // Relations
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploadedBy], references: [id])

  @@index([projectId])
}

// ============================================================================
// TIME TRACKING & EXPENSES (Future Use)
// ============================================================================

model TimeEntry {
  id          String   @id @default(cuid())
  projectId   String
  taskId      String?
  memberId    String
  workDate    DateTime
  hours       Decimal  @db.Decimal(10, 2)
  description String?  @db.Text
  isBillable  Boolean  @default(true)
  hourlyRate  Decimal? @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?      @relation(fields: [taskId], references: [id])
  member  TeamMember @relation(fields: [memberId], references: [id])

  @@index([projectId])
  @@index([memberId])
  @@index([workDate])
}

model ProjectExpense {
  id           String        @id @default(cuid())
  projectId    String
  category     String?
  description  String        @db.Text
  amount       Decimal       @db.Decimal(12, 2)
  currency     String        @default("USD")
  expenseDate  DateTime
  receiptUrl   String?
  isBillable   Boolean       @default(true)
  submittedBy  String
  approvedBy   String?
  status       ExpenseStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submitter TeamMember @relation("ExpenseSubmitter", fields: [submittedBy], references: [id])
  approver  User?      @relation("ExpenseApprover", fields: [approvedBy], references: [id])

  @@index([projectId])
  @@index([status])
}

// ============================================================================
// ACTIVITY LOG
// ============================================================================

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  entityType String
  entityId   String
  action     String
  changes    Json?
  ipAddress  String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

// ============================================================================
// SYSTEM SETTINGS (Future Use)
// ============================================================================

model SystemSetting {
  id           String   @id @default(cuid())
  settingKey   String   @unique
  settingValue String?  @db.Text
  settingType  String?
  description  String?  @db.Text
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
